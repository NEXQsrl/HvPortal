  "components": {
    "schemas": {
      "AssignmentEffect": {
        "enum": [
          "Allow",
          "Deny"
        ]
      },
      "AssignmentRequest": {
        "required": [
          "userId",
          "roleId",
          "scopeType",
          "scopeId",
          "effect"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "scopeType": {
            "$ref": "#/components/schemas/ScopeType"
          },
          "scopeId": {
            "type": [
              "null",
              "string"
            ]
          },
          "effect": {
            "$ref": "#/components/schemas/AssignmentEffect"
          }
        }
      },
      "ChangePasswordRequest": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "ConfirmRequest": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "CreateHostRequest": {
        "required": [
          "displayName"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          }
        }
      },
      "CreateUserRequest": {
        "required": [
          "userName",
          "displayName"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "LoginRequest": {
        "required": [
          "userName",
          "password"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MfaLoginRequest": {
        "required": [
          "challenge",
          "code",
          "recoveryCode"
        ],
        "type": "object",
        "properties": {
          "challenge": {
            "type": "string"
          },
          "code": {
            "type": [
              "null",
              "string"
            ]
          },
          "recoveryCode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MfaRequirement": {
        "enum": [
          "None",
          "Privileged",
          "All"
        ]
      },
      "PowerRequest": {
        "required": [
          "operation",
          "confirmName",
          "idempotencyKey"
        ],
        "type": "object",
        "properties": {
          "operation": {
            "$ref": "#/components/schemas/VmPowerOperation"
          },
          "confirmName": {
            "type": [
              "null",
              "string"
            ]
          },
          "idempotencyKey": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ReauthRequest": {
        "required": [
          "password",
          "code"
        ],
        "type": "object",
        "properties": {
          "password": {
            "type": "string"
          },
          "code": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RecoverRequest": {
        "required": [
          "token",
          "userName",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "RoleRequest": {
        "required": [
          "name",
          "description",
          "permissions"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ScopeType": {
        "enum": [
          "Global",
          "Host",
          "Cluster",
          "Group",
          "Vm",
          "Network",
          "BackupRepository",
          "Template"
        ]
      },
      "SecuritySettings": {
        "type": "object",
        "properties": {
          "mfaRequiredFor": {
            "$ref": "#/components/schemas/MfaRequirement"
          },
          "sessionIdleMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "sessionAbsoluteHours": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "passwordMinLength": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "localSignIn": {
            "type": "string"
          }
        }
      },
      "SetupRequest": {
        "required": [
          "setupToken",
          "userName",
          "displayName",
          "password"
        ],
        "type": "object",
        "properties": {
          "setupToken": {
            "type": "string"
          },
          "userName": {
            "type": "string"
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": "string"
          }
        }
      },
      "VmPowerOperation": {
        "enum": [
          "Start",
          "Shutdown",
          "Restart",
          "TurnOff",
          "Reset",
          "Pause",
          "Resume",
          "Save"
        ]
      }
    }
