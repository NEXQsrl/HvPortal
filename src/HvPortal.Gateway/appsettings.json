{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "EventLog": {
      "SourceName": "HvPortal Gateway",
      "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "UiPort": 8443,
    "AgentPort": 8444,
    "BindAddress": "0.0.0.0",
    "EnforcePortSeparation": true,
    "PublicNames": [],
    "UiCertificateThumbprint": null,
    "Database": { "Provider": "Sqlite" },
    "Security": {
      "Pbkdf2Iterations": 600000,
      "EnrollmentTokenMinutes": 15,
      "AgentCertificateDays": 90,
      "ReauthenticationWindowMinutes": 5
    },
    "Jobs": {
      "MaxConcurrentJobs": 8,
      "HostUnreachableRetries": 3,
      "ReconciliationGiveUpMinutes": 15
    }
  }
}
