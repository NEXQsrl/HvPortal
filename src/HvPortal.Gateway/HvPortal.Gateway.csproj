<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <AssemblyName>HvPortal.Gateway</AssemblyName>
    <RootNamespace>HvPortal.Gateway</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\SecureFileSystem.cs" Link="Shared\SecureFileSystem.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HvPortal.Contracts\HvPortal.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SPA (built from /web) is served from the executable directory, also when running as a Windows service. -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Security\common-passwords.txt" />
    <InternalsVisibleTo Include="HvPortal.Gateway.Tests" />
  </ItemGroup>

</Project>
