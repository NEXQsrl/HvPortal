# HvPortal gateway - example environment (copy to .env, or paste into Portainer > Stack > Environment variables).
# Never commit the real .env: it contains the key-encryption key.

# Image built from this repository (docker build -f docker/Dockerfile -t hvportal-gateway:0.9.0 .) or pushed to your registry.
HVP_IMAGE=hvportal-gateway:0.9.0
# never  = the image was imported on the Docker host (Portainer > Images > Import / docker load): do not pull it.
# missing / always = the image is in your private registry (HVP_IMAGE=registry.contoso.local/hvportal-gateway:0.9.0).
HVP_PULL_POLICY=never

# Ports published on the Docker host (the container listens on the same numbers).
#   HVP_UI_PORT    browsers -> web console (HTTPS)
#   HVP_AGENT_PORT Hyper-V agents -> gateway (mutual TLS). Open it from the Hyper-V hosts only.
HVP_UI_PORT=8443
HVP_AGENT_PORT=8444

# REQUIRED. DNS names and/or IP addresses of the Docker host that the Hyper-V hosts will use to reach the gateway,
# comma separated. They go into the agent-channel certificate: the agent refuses names that are not listed here.
HVP_PUBLIC_NAMES=hvportal.contoso.local,192.168.10.50

# REQUIRED. Key-encryption key protecting the gateway key ring (TOTP secrets, Entra client secret, internal CA key).
# Generate once:   openssl rand -base64 32
#   PowerShell:    [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# Store it in your password vault. Losing it means losing access to the data volume (restore a portal backup instead).
HVP_KEY_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_-base64_32

# First start: print the one-time setup token in the container log (Portainer > Containers > hvportal-gateway > Logs).
# Set to false after the initial setup.
HVP_PRINT_SETUP_TOKEN=true

# Optional: certificate for the web console from your PKI, mounted read-only from HVP_CERTS_DIR at /certs.
#   PFX:  HVP_UI_CERT_PATH=/certs/portal.pfx  and  HVP_UI_CERT_PASSWORD=...
#   PEM:  HVP_UI_CERT_PATH=/certs/portal.crt  and  HVP_UI_CERT_KEY_PATH=/certs/portal.key
# Leave empty to use the internal CA certificate (browsers show a warning; the CA can be imported from /agent/v1/ca).
HVP_CERTS_DIR=./certs
HVP_UI_CERT_PATH=
HVP_UI_CERT_KEY_PATH=
HVP_UI_CERT_PASSWORD=

# Time zone of the container (logs).
TZ=Europe/Rome
